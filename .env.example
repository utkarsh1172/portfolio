# Public base URL of the deployed site. Used for canonical URLs, sitemap,
# robots.txt and Open Graph tags. Must be a full URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: deliver contact-form messages by email through Resend
# (https://resend.com). If RESEND_API_KEY is unset, the form opens the
# visitor's email app with the message pre-filled instead.
RESEND_API_KEY=
# Sender address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=Portfolio <portfolio@your-domain.com>
# Where messages are delivered. Defaults to the email in src/data/profile.ts.
CONTACT_TO_EMAIL=

# Optional, server-only: a GitHub token (no scopes needed for public repos)
# to raise the API rate limit when fetching repos listed in src/data/github.ts.
# Never prefix this with NEXT_PUBLIC_.
GITHUB_TOKEN=
